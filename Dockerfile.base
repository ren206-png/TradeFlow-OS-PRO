# Base image — contains only OS deps + pip packages.
# Rebuilt by .github/workflows/build-base.yml when requirements.txt changes.
# The main Dockerfile inherits FROM this, so normal code pushes skip pip install.

FROM python:3.11-slim

WORKDIR /app

# System deps needed to compile asyncpg + cryptography
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
