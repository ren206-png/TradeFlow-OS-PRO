# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# ── Retell ────────────────────────────────────────────────────────────────────
RETELL_API_KEY=key_...
RETELL_WEBHOOK_SECRET=whsec_...

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
# Required for A2P 10DLC compliance — set in Railway after brand registration
TWILIO_MESSAGING_SERVICE_SID=MG...

# ── Database ──────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically when you add a Postgres plugin.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradeflow

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Change these in Railway — do NOT leave admin_password empty in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Notifications are silently disabled if left empty.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG....
SMTP_FROM=noreply@tradesflowos.com

# ── Mailchimp ─────────────────────────────────────────────────────────────────
# Drip email sequence is disabled if left empty.
MAILCHIMP_API_KEY=...
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=...

# ── Live Demo Line ────────────────────────────────────────────────────────────
# Set these in Railway after provisioning the demo tenant with Retell.
DEMO_PHONE_NUMBER=+1...
DEMO_CONTRACTOR_ID=<uuid-of-demo-contractor-row>
DEMO_DAILY_CALL_CAP=50
DEMO_MAX_CALL_MINS=3

# ── Plan Limits (override defaults) ──────────────────────────────────────────
PLAN_STARTER_CALLS=100
PLAN_STARTER_SMS=200
PLAN_PRO_CALLS=500
PLAN_PRO_SMS=1000
PLAN_STARTER_MAX_CALL_MINS=10
PLAN_PRO_MAX_CALL_MINS=30
PLAN_ENTERPRISE_CALLS=9999
PLAN_ENTERPRISE_SMS=9999
PLAN_ENTERPRISE_MAX_CALL_MINS=60

# ── Feature Flags (all default OFF — flip in Railway env vars) ────────────────
# Phase 1
EMERGENCY_TRIAGE=false
LIVE_TRANSFER=false
FSM_SYNC=false
INTAKE_FLOWS_V2=false

# Phase 2
MISSED_CALL_TEXTBACK=false
WEBFORM_CALLBACK=false
LEAD_SOURCE_INGEST=false

# Phase 3
FOLLOWUP_SMS_ENABLED=false
TRIAGE_LIBRARY_V2=false
SAFETY_COACHING=false

# Phase 4
APPOINTMENT_LIFECYCLE=false
ESTIMATE_FOLLOWUP=false
REACTIVATION_CAMPAIGNS=false

# Phase 5
OWNER_DASHBOARD_V2=false
SPAM_SHIELD=false

# Phase 6
WEATHER_SURGE_MODE=false
FRENCH_BILINGUAL=false
COMMERCIAL_INTAKE=false

# Other
TRUST_V2=false
MOBILE_HERO_V2=false
LIVE_METRICS=false
MULTILANG_ENABLED=false
MULTILANG_VOICE_ID=11labs-Valentina
MAX_CONCURRENT_CALLS=50
